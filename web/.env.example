# Contact form email delivery (Resend — https://resend.com)
# Copy to `.env` and fill in. `.env` is gitignored.

# Required to actually send. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form enquiries are delivered.
CONTACT_TO_EMAIL=info@utaliicreative.com

# Sender address. Must be on a domain verified in your Resend account.
# For quick testing without a verified domain, Resend allows:
#   DCI Website <onboarding@resend.dev>   (delivers only to your own account email)
CONTACT_FROM_EMAIL=DCI Website <hello@deeperconnectioninitiative.com>
