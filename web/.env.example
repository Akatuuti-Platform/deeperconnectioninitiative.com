# Contact form email delivery (Resend — https://resend.com)
# Copy to `.env` and fill in. `.env` is gitignored.

# Flutterwave payments (https://app.flutterwave.com/dashboard/settings/apis)
# The secret key is used server-side to create and verify payments. Never
# expose it to the client. Set both in Vercel project env vars for production.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Webhook secret hash: set the same value in the Flutterwave dashboard under
# Settings > Webhooks. Payment notifications are emailed to ORDERS_TO_EMAIL
# (falls back to CONTACT_TO_EMAIL).
FLUTTERWAVE_WEBHOOK_HASH=
ORDERS_TO_EMAIL=

# Required to actually send. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form enquiries are delivered.
CONTACT_TO_EMAIL=info@utaliicreative.com

# Sender address. Must be on a domain verified in your Resend account.
# For quick testing without a verified domain, Resend allows:
#   DCI Website <onboarding@resend.dev>   (delivers only to your own account email)
CONTACT_FROM_EMAIL=DCI Website <hello@deeperconnectioninitiative.com>
